# Supabase
# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública/anon do Supabase (Settings > API) — segura para uso no client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA expor no client, usar apenas em Server
# Components / Route Handlers. Necessária para operações administrativas futuras.
SUPABASE_SERVICE_ROLE_KEY=

# --- Preparado para fases futuras (ainda não usado) ---
# Chave da Google Places API (Fase 2)
GOOGLE_PLACES_API_KEY=
